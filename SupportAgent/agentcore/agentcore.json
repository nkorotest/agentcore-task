{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "SupportAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "SupportAgent"
  },
  "runtimes": [],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "SupportGateway",
      "protocolType": "MCP",
      "description": "Business tools for the customer support agent",
      "targets": [
        {
          "name": "OrdersTarget",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:062788795353:function:support-get-order-status",
            "toolSchemaFile": "../backend/tool_schemas/orders.json"
          }
        },
        {
          "name": "CustomersTarget",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:062788795353:function:support-get-customer",
            "toolSchemaFile": "../backend/tool_schemas/customers.json"
          }
        },
        {
          "name": "RefundsTarget",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:062788795353:function:support-refund-customer",
            "toolSchemaFile": "../backend/tool_schemas/refunds.json"
          }
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}