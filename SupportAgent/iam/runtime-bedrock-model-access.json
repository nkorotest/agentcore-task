{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEveryBedrockModelExceptTheAgentModel",
      "Effect": "Deny",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream",
        "bedrock:CountTokens"
      ],
      "NotResource": [
        "arn:aws:bedrock:*:536035781966:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0"
      ]
    }
  ]
}
